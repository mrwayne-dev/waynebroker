# ============================================================
# Maveren Capital - environment template
#
# Copy to .env and fill in. NEVER commit the real .env: it is gitignored,
# and the root .htaccess denies it over HTTP (both are required - the
# .htaccess catch-all 404 is gated on `!-f`, so any real file on disk is
# served verbatim without an explicit deny).
#
# config/env.php parses this file directly on every request - there is no
# cache, so an edit is live on the next hit with nothing to flush or restart.
#
# Keys marked REQUIRED abort the app with a 500 at boot if missing.
# ============================================================

# --- Database (REQUIRED except DB_PASS) ---------------------------------
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- Application --------------------------------------------------------
APP_NAME=Maveren Capital
# Used to build the NowPayments ipn_callback_url / success_url / cancel_url,
# so it MUST be the host the payment provider can actually reach. Pointing
# this at production while developing locally means IPNs never come back.
APP_URL=https://example.com
# local | development | dev  -> dev mode. Anything else -> production.
APP_ENV=production
SESSION_LIFETIME=86400

# --- Mail (HOST, USER, PASS and FROM are all REQUIRED) ------------------
# Leaving SMTP_PASS blank does NOT mean "no authentication" - the app still
# offers empty credentials, the server rejects them, and every send fails.
# config/env.php refuses to boot without it, because the failure is otherwise
# invisible: members are told their verification code was sent and it never
# arrives.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Maveren Capital
# Where admin notifications and contact-form copies land. Falls back to
# SMTP_FROM when unset.
SMTP_TO=

# --- Admin --------------------------------------------------------------
# Required to register a new administrator. An empty value is explicitly
# refused by api/auth/admin_register.php rather than matching everything.
ADMIN_INVITE_CODE=

# --- NowPayments (both REQUIRED) ----------------------------------------
# Rotating either of these means updating BOTH here and in the NowPayments
# dashboard. A mismatch on the IPN secret makes every callback fail its
# signature check and 403 - deposits then sit pending forever with no error
# surfaced to anyone.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Set to exactly "true" to let create_crypto_payment.php retry with TLS peer
# verification DISABLED when the first call fails. It re-sends the live API
# key over an unverified channel, so leave this unset unless you are
# debugging a local certificate problem. Ignored when APP_ENV=production.
NOWPAY_INSECURE_FALLBACK=

# Note: NOWPAYMENTS_PUBLIC_KEY was read by config/env.php but referenced
# nowhere in the application. It has been dropped - no need to set it.
