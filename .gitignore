# =========================================================
# Maveren Capital - .gitignore
# =========================================================

# ----- Environment / secrets -----
.env
.env.local
.env.*.local
*.env.backup

# ----- Logs -----
logs/
*.log

# ----- Editor / OS noise -----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ----- PHP / Composer -----
vendor/
composer.lock

# ----- Node (if added later) -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Local SQL dumps / backups -----
*.sql.bak
dbschema/local-*.sql

# Live wallet addresses - applied directly, never published (public repo)
dbschema/deposit_addresses_live.sql

# ----- Member-uploaded content -----
# Identity documents must never be committed. The directory and its guards are
# tracked; nothing a member sends us is. This is a hard rule, not tidiness:
# a KYC document in git history is a passport in every clone of the repo.
uploads/kyc/*
!uploads/kyc/.htaccess
!uploads/kyc/index.html
uploads/profiles/*
uploads/contacts/*
uploads/contact/*
uploads/products/*
!uploads/**/.gitkeep
!uploads/**/.htaccess

# ----- Translation cache -----
# Generated at runtime and owned by the web-server user. Rebuild with
# scripts/i18n_warm.php after a deploy.
cache/i18n/*
!cache/.htaccess

# ----- Working screenshots -----
# shots/ is scratch output from the headless-Chrome verification runs. Useful
# while building, not part of the product.
shots/
.env.production
.env.dbpass
