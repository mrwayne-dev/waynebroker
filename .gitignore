# ── Environment / secrets ─────────────────────────────────
.env
.env.*
!.env.example
*.env.backup

# ── PHP / Composer ────────────────────────────────────────
vendor/
composer.lock
# (composer.lock IS committed for applications; we un-ignore it
#  once Laravel is scaffolded. Kept ignored while _legacy/ still
#  holds Maveren's outdated lock.)

# ── Node / Vite ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Laravel runtime ───────────────────────────────────────
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# ── Editor / OS ───────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Tooling artifacts ─────────────────────────────────────
.phpunit.result.cache
.phpunit.cache
.pest.cache
.playwright-report/
/test-results/
/coverage/
.storybook/build/
storybook-static/

# ── Claude Code local state ───────────────────────────────
.claude/

# ── Legacy Maveren carryovers (rules preserved from _legacy/) ─
_legacy/logs/
_legacy/shots/
_legacy/vendor/
_legacy/cache/i18n/*
!_legacy/cache/.htaccess
_legacy/uploads/kyc/*
!_legacy/uploads/kyc/.htaccess
!_legacy/uploads/kyc/index.html
_legacy/uploads/profiles/*
_legacy/uploads/contacts/*
_legacy/uploads/contact/*
_legacy/uploads/products/*
!_legacy/uploads/**/.gitkeep
!_legacy/uploads/**/.htaccess
_legacy/dbschema/deposit_addresses_live.sql
_legacy/dbschema/local-*.sql

# Ladle component-story build output (dev tooling, not shipped)
/build
/playwright-report
